# viewer/.env on the Docker host (never committed).
# Name of the existing people-count volume to reuse (docker volume ls).
DATA_VOLUME=6b4031bc50ff01fc40f1130bdb8051896cd1ae30919f5944b3cce157f5c6040d

# Email alerts (recording stopped/resumed, camera restarted, NAS down/back, daily summary at 9:00).
# Gmail app password, not the account password. Leave empty to turn alerts off.
ALERT_SMTP_USER=you@gmail.com
ALERT_SMTP_PASS=
ALERT_TO=you@gmail.com
